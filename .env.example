# ---------------------------------------------------------------------------
# GRIDLOCK — environment configuration
# Copy to `.env` and fill in. Every value is optional: with no configuration
# the app runs against a local SQLite file in ./data.
# ---------------------------------------------------------------------------

# --- Supabase (enables cross-device stats and true online multiplayer) ------
# Project settings -> API -> Project URL / anon public key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

# Server-side key. Only needed if you run maintenance scripts; never ship it
# to the browser and never commit it.
SUPABASE_SERVICE_KEY=

# --- Authentication ---------------------------------------------------------
# Set to true after enabling the Google provider in Supabase -> Authentication.
ENABLE_GOOGLE_AUTH=false
# Where Supabase should send the browser back to after sign-in.
OAUTH_REDIRECT_URL=http://localhost:8501

# --- Local behaviour --------------------------------------------------------
# Where the SQLite fallback database lives.
TTT_DATA_DIR=./data
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Set to true to ignore Supabase even when credentials are present.
FORCE_LOCAL_BACKEND=false
