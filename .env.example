# ---------------------------------------------------------------------------
# GRIDLOCK — environment configuration
#
# Copy this file to `.env` and fill in what you need. Everything here is
# optional: with no configuration at all, the app stores games in a local
# SQLite file under ./data and runs perfectly.
#
# `.env` is listed in .gitignore and must never be committed. This file, with
# its placeholder values, is the one that belongs in the repository.
# ---------------------------------------------------------------------------


# --- Supabase --------------------------------------------------------------
# Adding these switches on cross-device play, accounts, and permanent stats.
#
#   Project URL      Project Settings -> Data API
#   Publishable key  Project Settings -> API Keys
#
# Older Supabase projects show an "anon public" key instead of a publishable
# one. Either works — paste whichever your dashboard gives you.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_your_key_here

# The secret key (sb_secret_... or "service_role") bypasses every security rule
# on your database. This app never needs it. Leave it blank, keep it out of
# your repository, and never paste it anywhere public.
SUPABASE_SERVICE_KEY=


# --- Authentication --------------------------------------------------------
# Email and password sign-up works as soon as Supabase is configured above —
# no extra settings needed.

# Set to true only after enabling the Google provider in
# Supabase -> Authentication -> Sign In / Providers.
ENABLE_GOOGLE_AUTH=false

# Where the browser returns after signing in. Change this to your deployed
# address once the app is live, e.g. https://gridlock.streamlit.app
OAUTH_REDIRECT_URL=http://localhost:8501


# --- Local behaviour -------------------------------------------------------
# Folder for the local SQLite database used when Supabase is not configured.
TTT_DATA_DIR=./data

# How much detail is printed to the terminal: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Set to true to ignore Supabase even when credentials are present. Useful for
# testing offline behaviour.
FORCE_LOCAL_BACKEND=false
