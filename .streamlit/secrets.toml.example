# Streamlit Community Cloud reads secrets from this file (paste the contents
# into the "Secrets" box in the app settings). Values mirror .env.example.

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-anon-public-key"
ENABLE_GOOGLE_AUTH = "false"
OAUTH_REDIRECT_URL = "https://your-app.streamlit.app"
